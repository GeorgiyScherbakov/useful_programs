","from IPython.display import HTML\n","\n","# 1. Konfiguracja parametrów wahadła\n","g = 9.81        # Przyspieszenie ziemskie (m/s^2)\n","L = 2.0         # Długość nici (m)\n","theta_max = np.radians(45) # Maksymalne wychylenie (amplituda)\n","\n","# Czas trwania animacji\n","fps = 30\n","duration = 5    # sekundy\n","frames = fps * duration\n","t = np.linspace(0, duration, frames)\n","\n","# Przybliżone równanie ruchu dla małych/średnich wychyleń: theta(t) = theta_max * cos(omega * t)\n","omega = np.sqrt(g / L)\n","theta = theta_max * np.cos(omega * t)\n","\n","# Współrzędne x, y końca wahadła\n","x = L * np.sin(theta)\n","y = -L * np.cos(theta)\n","\n","# 2. Tworzenie wykresów i animacji\n","fig, ax = plt.subplots(figsize=(6, 6))\n","ax.set_xlim(-L * 1.2, L * 1.2)\n","ax.set_ylim(-L * 1.2, L * 1.2)\n","ax.set_aspect('equal')\n","ax.grid(True)\n","ax.set_title(\"Animacja Wahadła Fizycznego\")\n","\n","# Elementy graficzne: linia (nić) i kropka (ciężarek)\n","line, = ax.plot([], [], 'o-', lw=3, markersize=12, color='royalblue')\n","trace, = ax.plot([], [], '--', lw=1, color='orange', alpha=0.5)\n","x_trace, y_trace = [], []\n","\n","def init():\n","    line.set_data([], [])\n","    trace.set_data([], [])\n","    return line, trace\n","\n","def animate(i):\n","    # Aktualizacja pozycji nici i ciężarka\n","    this_x = [0, x[i]]\n","    this_y = [0, y[i]]\n","    line.set_data(this_x, this_y)\n","\n","    # Dodanie śladu ruchu\n","    x_trace.append(x[i])\n","    y_trace.append(y[i])\n","    if len(x_trace) > 30:  # ograniczamy długość śladu\n","        x_trace.pop(0)\n","        y_trace.pop(0)\n","    trace.set_data(x_trace, y_trace)\n","\n","    return line, trace\n","\n","# Tworzenie obiektu animacji\n","ani = animation.FuncAnimation(fig, animate, init_func=init,\n","                              frames=frames, interval=1000/fps, blit=True)\n","\n","# 3. Zapis do pliku video.mp4\n","# Wymaga zainstalowanego ffmpeg w środowisku Colab (zazwyczaj jest domyślnie)\n","print(\"Zapisywanie pliku wideo...\")\n","output_file = 'video.mp4'\n","writer = animation.FFMpegWriter(fps=fps, metadata=dict(artist='Me'), bitrate=1800)\n","ani.save(output_file, writer=writer)\n","print(f\"Zapisano animację jako: {output_file}\")\n","\n","plt.close(fig)\n","\n","# 4. Osadzenie i wyświetlenie wideo w notebooku\n","HTML(ani.to_html5_video())"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":656},"id":"uBOgthvzE9Sz","executionInfo":{"status":"ok","timestamp":1791893041587,"user_tz":-120,"elapsed":19920,"user":{"displayName":"Georgiy Scherbakov","userId":"09369088841519477996"}},"outputId":"067e59ad-f542-4cd8-bd7c-92214fe47c62"},"execution_count":16,"outputs":[{"output_type":"stream","name":"stdout","text":["Zapisywanie pliku wideo...\n","Zapisano animację jako: video.mp4\n"]},{"output_type":"execute_result","data":{"text/plain":["<IPython.core.display.HTML object>"],"text/html":["<video width=\"600\" height=\"600\" controls autoplay loop>\n","  <source type=\"video/mp4\" src=\"data:video/mp4;base64,AAAAIGZ0eXBNNFYgAAACAE00ViBpc29taXNvMmF2YzEAAAAIZnJlZQAAzdFtZGF0AAACrgYF//+q\n","3EXpvebZSLeWLNgg2SPu73gyNjQgLSBjb3JlIDE2NCByMzEwOCAzMWUxOWY5IC0gSC4yNjQvTVBF\n","Ry00IEFWQyBjb2RlYyAtIENvcHlsZWZ0IDIwMDMtMjAyMyAtIGh0dHA6Ly93d3cudmlkZW9sYW4u\n","b3JnL3gyNjQuaHRtbCAtIG9wdGlvbnM6IGNhYmFjPTEgcmVmPTMgZGVibG9jaz0xOjA6MCBhbmFs\n","eXNlPTB4MzoweDExMyBtZT1oZXggc3VibWU9NyBwc3k9MSBwc3lfcmQ9MS4wMDowLjAwIG1peGVk\n","X3JlZj0xIG1lX3JhbmdlPTE2IGNocm9tYV9tZT0xIHRyZWxsaXM9MSA4eDhkY3Q9MSBjcW09MCBk\n","ZWFkem9uZT0yMSwxMSBmYXN0X3Bza2lwPTEgY2hyb21hX3FwX29mZnNldD0tMiB0aHJlYWRzPTMg\n","bG9va2FoZWFkX3RocmVhZHM9MSBzbGljZWRfdGhyZWFkcz0wIG5yPTAgZGVjaW1hdGU9MSBpbnRl\n","cmxhY2VkPTAgYmx1cmF5X2NvbXBhdD0wIGNvbnN0cmFpbmVkX2ludHJhPTAgYmZyYW1lcz0zIGJf\n","cHlyYW1pZD0yIGJfYWRhcHQ9MSBiX2JpYXM9MCBkaXJlY3Q9MSB3ZWlnaHRiPTEgb3Blbl9nb3A9\n","MCB3ZWlnaHRwPTIga2V5aW50PTI1MCBrZXlpbnRfbWluPTI1IHNjZW5lY3V0PTQwIGludHJhX3Jl\n","ZnJlc2g9MCByY19sb29rYWhlYWQ9NDAgcmM9Y3JmIG1idHJlZT0xIGNyZ