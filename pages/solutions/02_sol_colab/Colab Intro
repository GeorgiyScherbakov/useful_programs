 metadanych (w tym liczby klatek na sekundę - fps)\n","# imageio.imread reads the frames; we can also use metadata to extract fps\n","frames = []\n","fps = 30 # domyślna wartość zapasowa, gdyby metadane nie podawały fps\n","\n","# Odczyt klatek za pomocą imageio (v3)\n","for frame in iio.imiter(input_video):\n","    frames.append(frame)\n","\n","# Pobranie metadanych wideo (np. fps)\n","try:\n","    meta = iio.improps(input_video)\n","    # jeśli metadane zawierają informację o czasie/klatkach, możemy dostosować duration\n","    # duration dla pojedynczej klatki w sekundach = 1 / fps\n","except Exception:\n","    pass\n","\n","# Czas trwania jednej klatki w milisekundach (standardowo przyjmujemy 30 fps -> ~33ms)\n","duration_ms = 1000 / 30\n","\n","# 3. Zapis do pliku GIF\n","print(f\"Generowanie pliku GIF (zapis w bieżącym katalogu roboczym)...\")\n","iio.imwrite(output_gif, frames, duration=duration_ms, loop=0) # loop=0 oznacza zapętlenie w nieskończoność\n","\n","# 4. Sprawdzenie i potwierdzenie ścieżki zapisu\n","absolute_path = os.path.abspath(output_gif)\n","print(f\"Sukces! Plik GIF został zapisany jako: {absolute_path}\")\n","\n","# 5. Podgląd wygenerowanego pliku GIF bezpośrednio w notebooku\n","display(Image(filename=output_gif))"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":669},"id":"M3Q8hzEnFlim","executionInfo":{"status":"ok","timestamp":1791893051234,"user_tz":-120,"elapsed":9645,"user":{"displayName":"Georgiy Scherbakov","userId":"09369088841519477996"}},"outputId":"0c4f6095-2c8d-4b43-f36d-b331a3187ac4"},"execution_count":17,"outputs":[{"output_type":"stream","name":"stdout","text":["Wczytywanie wideo z pliku: /content/video.mp4...\n","Generowanie pliku GIF (zapis w bieżącym katalogu roboczym)...\n","Sukces! Plik GIF został zapisany jako: /content/video.gif\n"]},{"output_type":"display_data","data":{"image/gif":"\n","text/plain":["<IPython.core.display.Image object>"]},"metadata":{}}]},{"cell_type":"code","source":["import numpy as np\n","import matplotlib.pyplot as plt\n","from IPython.display import Image, display\n","import os\n","\n","# 1. Definicja parametrów dla krzywej parametrycznej (Róża / Rodoneja)\n","# Wzór w kartezjańskim układzie współrzędnych dla róży polarnej:\n","# r = a * cos(k * t)\n","# x = r * cos(t)\n","# y = r * sin(t)\n","\n","t = np.linspace(0, 2 * np.pi, 1000)\n","k = 4.0  # Liczba płatków (dla liczby parzystej k płatków jest 2*k, czyli 8)\n","a = 5.0  # Promień / skala\n","\n","r = a * np.cos(k * t)\n","x = r * np.cos(t)\n","y = r * np.sin(t)\n","\n","# 2. Tworzenie wykresu\n","fig, ax = plt.subplots(figsize=(6, 6))\n","ax.plot(x, y, color='magenta', lw=2, label=f'Róża parametryczna (k={k})')\n","\n","# Stylizacja wykresu\n","ax.set_facecolor('#111111') # Ciemne tło dla lepszego efektu wizualnego\n","fig.patch.set_facecolor('#f4f4f4')\n","ax.set_title(f\"Krzywa Parametryczna: Róża (k={k})\", fontsize=14, pad=15)\n","ax.set_aspect('equal')\n","ax.grid(True, color='#444444', linestyle='--', alpha=0.5)\n","ax.legend(loc='upper right')\n","\n","# 3. Zapis do pliku parametric_curve.png\n","output_image = 'parametric_curve.png'\n","plt.savefig(output_image, dpi=300, bbox_inches='tight')\n","\n","absolute_path = os.path.abspath(output_image)\n","print(f\"Sukces! Wykres został zapisany jako: {absolute_path}\")\n","\n","# Wyświetlenie wykresu na matrycy notebooka\n","plt.show()\n","plt.close(fig)\n","\n","# 4. Podgląd wygenerowanego pliku graficznego\n","display(Image(filename=output_image))"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":1000},"id":"N2bz7t4vGHfQ","executionInfo":{"status":"ok","timestamp":1791893051455,"user_tz":-120,"elapsed":217,"user":{"displayName":"Georgiy Scherbakov","userId":"09369088841519477996"}},"outputId":"4a689602-6038-4a82-895d-a0e5ca131614"},"execution_count":18,"outputs":[{"output_type":"stream","name":"stdout","text":["Sukces! Wykres został zapisany jako: /content/parametric_curve.png\n"]},{"output_type":"display_da