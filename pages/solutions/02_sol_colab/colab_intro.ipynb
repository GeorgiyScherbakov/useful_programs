    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "k = np.arange(1, 21)\n",
    "y = k ** 2\n",
    "\n",
    "plt.figure(figsize=(8, 6))\n",
    "plt.plot(k, y, marker='o')\n",
    "plt.title('y = k^2 dla k = 1, 2, ..., 20')\n",
    "plt.xlabel('k')\n",
    "plt.ylabel('y')\n",
    "plt.grid(True)\n",
    "plt.savefig('wykres.png', dpi=150)\n",
    "plt.show()"
   ]
