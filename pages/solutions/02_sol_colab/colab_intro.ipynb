   "source": [
    "import numpy as np\n",
    "import matplotlib\n",
    "matplotlib.use('Agg')\n",
    "import matplotlib.pyplot as plt\n",
    "from matplotlib.animation import FuncAnimation\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(6, 4))\n",
    "x = np.linspace(-2, 2, 400)\n",
    "line, = ax.plot([], [], lw=2)\n",
    "ax.set_xlim(-2, 2)\n",
    "ax.set_ylim(-1.5, 1.5)\n",
    "ax.set_title('Wahadło')\n",
    "\n",
    "t = np.linspace(0, 2*np.pi, 200)\n",
    "theta = np.sin(t)\n",
    "\n",
    "def init():\n",
    "    line.set_data([], [])\n",
    "    return (line,)\n",
    "\n",
    "def update(frame):\n",
    "    x0 = 0\n",
    "    y0 = 0\n",
    "    x1 = np.sin(theta[frame])\n",
    "    y1 = -np.cos(theta[frame])\n",
    "    line.set_data([x0, x1], [y0, y1])\n",
    "    return (line,)\n",
    "\n",
    "anim = FuncAnimation(fig, update, frames=len(t), init_func=init, blit=True, interval=30)\n",
    "anim.save('video.mp4', writer='ffmpeg', fps=30)\n",
    "plt.close(fig)\n",
    "print('Zapisano video.mp4')"
   ]
  },
